# Copy this file to ".env" and fill in your real values.
# NEVER upload ".env" to GitHub.

# Long random string used to sign login sessions.
# Generate one with:  py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# Your MongoDB Atlas connection string.
# If your password has special characters (@ : / ?), URL-encode them.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority

# Name of the database RentEase will use
DB_NAME=rentease

# 1 = debug mode for local development ONLY. Use 0 for anything else.
FLASK_DEBUG=1

# Set to 1 only when the site is served over HTTPS
SESSION_COOKIE_SECURE=0